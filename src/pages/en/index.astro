---
const title = "Evgeniy Yaremenko | Senior DevOps Engineer";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<style>
			body { background: #0f172a; color: #f8fafc; font-family: sans-serif; padding: 2rem; }
			.container { max-width: 800px; margin: auto; }
			.hero { border-left: 4px solid #38bdf8; padding-left: 1.5rem; margin-bottom: 3rem; }
			h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
			.tagline { color: #38bdf8; font-size: 1.2rem; font-weight: bold; }
			.badge { background: #1e293b; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.9rem; margin-right: 0.5rem; display: inline-block; margin-top: 0.5rem; border: 1px solid #334155; }
		</style>
	</head>
	<body>
		<div class="container">
			<nav>
				<a href="/en/" style="color: #38bdf8;">EN</a> | <a href="/uk/" style="color: #94a3b8;">UK</a>
			</nav>

			<section class="hero">
				<h1>Evgeniy Yaremenko</h1>
				<p class="tagline">Senior DevOps / SRE Engineer</p>
				<p>I specialize in building resilient infrastructure, K8s networking (Cilium/eBPF), and automating complex systems like high-frequency trading bots.</p>
				
				<div class="skills">
					<span class="badge">Kubernetes</span>
					<span class="badge">Terraform / IaC</span>
					<span class="badge">AWS / GCP</span>
					<span class="badge">Python / Go</span>
					<span class="badge">DevSecOps</span>
				</div>
			</section>

			<section>
				<h2>Current Focus</h2>
				<p>Optimizing <strong>Freqtrade</strong> strategies on Binance Futures and implementing advanced observability for Docker-based trading clusters.</p>
			</section>
		</div>
	</body>
</html>